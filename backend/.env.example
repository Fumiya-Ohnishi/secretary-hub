# コピーして .env にリネームして値を入れる(.env は git に入りません)
ANTHROPIC_API_KEY=sk-ant-ここに貼る
# 秘書の頭脳のモデル(既定: claude-opus-5-5)。考える深さ: low(速い)/ medium / high
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
SECRETARY_NAME=セナ

# Notion(タスクと資料)。README「Notion をつなぐ」の手順で作ったシークレットを入れる
# NOTION_TOKEN=ntn_ここに貼る

# AI会社リポジトリの場所(既定: secretary-hub フォルダと同じ階層の ai-company)
# AI_COMPANY_DIR=/Users/あなた/ai-company
# 声: VOICEVOX(無料の読み上げソフト)を起動しておくと、その声で話します。声の名前の一部か数字のID
# VOICEVOX_SPEAKER=冥鳴ひまり

# 完成した画像・動画の置き場所。空なら Mac の Google ドライブ(マイドライブ/AI会社/投稿素材)を自動で使う
MEDIA_DIR=
# ドライブに写し終わった画像・動画を、この日数がたったら Mac(content/output)から消す(ドライブには残る)。0 で消さない
LOCAL_MEDIA_KEEP_DAYS=14

# 部署の作業(Claude Code)を API の残高で動かすときだけ 1 にする。空ならログイン中のプラン(Pro / Max)の枠で動く
JOBS_USE_API_KEY=

# 部署の作業の制限時間(分)。空なら 90 分。大きい作業が時間切れで止まるときに延ばす
JOB_TIMEOUT_MIN=

# Instagram の数字(Meta 公式の Graph API)。手順は ai-company の playbooks/instagram_api_setup.md
# トークンは短い期限のものでよい(アプリID・シークレットがあれば、期限なしのページ用トークンに自動で交換して backend/data に保存)
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# (2026-11-12)別アカウントの Instagram(アプリID・シークレットは上と同じ)
IG_SUB_ACCESS_TOKEN=
# Threads の数字(本アカウント・別アカウント)。手順は ai-company の playbooks/account_connect.md
THREADS_ACCESS_TOKEN=
THREADS_SUB_ACCESS_TOKEN=
THREADS_APP_SECRET=
# YouTube の数字(Google Cloud の APIキー。YouTube Data API v3)
YOUTUBE_API_KEY=
# YouTube アナリティクス(総再生時間・視聴を継続)。Google Cloud の OAuth クライアント(ウェブ アプリケーション)。リダイレクト URI は http://localhost:8000/api/youtube/oauth/callback
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
# IG_USER_ID=

# 社外制作室(Codex): 別の会社のAI(OpenAI)に投稿の別案を作らせる
# Codex 本体は ChatGPT のプランでログイン(ターミナルで npm install -g @openai/codex → codex login)。下のキーは画像・動画の生成だけに使う
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VIDEO_MODEL=sora-2
# CODEX_USE_API_KEY=1   # Codex 本体も API キー(従量課金)で動かすとき

# 会社のフォルダ(ai-company)を10分ごとに自動で保存・GitHub とそろえる(止めるときは 0)
# AUTO_GIT_SYNC=1
