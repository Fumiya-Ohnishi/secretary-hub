# コピーして .env にリネームして値を入れる(.env は git に入りません)
ANTHROPIC_API_KEY=sk-ant-ここに貼る
# 秘書の頭脳のモデル(既定: claude-opus-5-5)。考える深さ: low(速い)/ medium / high
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
SECRETARY_NAME=セナ

# Notion(タスクと資料)。README「Notion をつなぐ」の手順で作ったシークレットを入れる
# NOTION_TOKEN=ntn_ここに貼る

# AI会社リポジトリの場所(既定: secretary-hub フォルダと同じ階層の ai-company)
# AI_COMPANY_DIR=/Users/あなた/ai-company
# 声: VOICEVOX(無料の読み上げソフト)を起動しておくと、その声で話します。声の名前の一部か数字のID
# VOICEVOX_SPEAKER=冥鳴ひまり

# 完成した画像・動画の置き場所。空なら Mac の Google ドライブ(マイドライブ/AI会社/投稿素材)を自動で使う
MEDIA_DIR=

# 部署の作業(Claude Code)を API の残高で動かすときだけ 1 にする。空ならログイン中のプラン(Pro / Max)の枠で動く
JOBS_USE_API_KEY=

# 部署の作業の制限時間(分)。空なら 90 分。大きい作業が時間切れで止まるときに延ばす
JOB_TIMEOUT_MIN=
